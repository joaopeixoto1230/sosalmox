rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function hasRole(roles) {
      return isAuthenticated() && getUserData().perfil in roles;
    }

    function isActive() {
      return getUserData().ativo != false;
    }

    match /usuarios/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || hasRole(['admin']));
      allow write: if hasRole(['admin']) && isActive();
    }

    match /eventos/{docId} {
      allow read: if isAuthenticated() && isActive();
      allow write: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
    }

    match /geradores/{docId} {
      allow read: if isAuthenticated() && isActive();
      allow write: if hasRole(['admin', 'gerente', 'almoxarife', 'franca']) && isActive();
    }

    match /caminhoes/{docId} {
      allow read: if isAuthenticated() && isActive();
      allow write: if hasRole(['admin', 'gerente', 'almoxarife', 'franca']) && isActive();
    }

    match /materiais/{docId} {
      allow read: if isAuthenticated() && isActive();
      allow write: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
    }

    match /ordens_saida/{docId} {
      allow read: if isAuthenticated() && isActive();
      allow create: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
      allow update: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
      allow delete: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
    }

    match /devolucoes/{docId} {
      allow read: if isAuthenticated() && isActive();
      allow create: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
      allow delete: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
    }

    match /transferencias/{docId} {
      allow read: if isAuthenticated() && isActive();
      allow create: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
    }

    match /contadores/{docId} {
      allow read: if isAuthenticated() && isActive();
      allow write: if isAuthenticated() && isActive();
    }

    // Notificações do sininho. Leitura/escrita para qualquer usuário ativo;
    // o filtro de quem vê o quê é feito no app (uid, 'all' ou paraPerfis).
    match /notificacoes/{docId} {
      allow read: if isAuthenticated() && isActive();
      allow create: if isAuthenticated() && isActive();
      allow update: if isAuthenticated() && isActive();
      allow delete: if hasRole(['admin', 'gerente']) && isActive();
    }

    // Fase 3 — Compras (todos menos o franca/mecanico)
    match /solicitacoes_compra/{docId} {
      allow read: if hasRole(['admin', 'gerente', 'almoxarife', 'compras']) && isActive();
      allow write: if hasRole(['admin', 'gerente', 'almoxarife', 'compras']) && isActive();
    }

    match /fornecedores/{docId} {
      allow read: if hasRole(['admin', 'gerente', 'almoxarife', 'compras']) && isActive();
      allow write: if hasRole(['admin', 'gerente', 'almoxarife', 'compras']) && isActive();
    }

    // Tipos de material da solicitação (lista de padrões criada pelos colaboradores)
    match /tipos_solicitacao/{docId} {
      allow read: if hasRole(['admin', 'gerente', 'almoxarife', 'compras']) && isActive();
      allow create: if hasRole(['admin', 'gerente', 'almoxarife', 'compras']) && isActive();
      allow delete: if hasRole(['admin', 'gerente', 'compras']) && isActive();
    }

    // Assinatura do solicitante (fora do doc da solicitação, p/ não pesar a fila)
    match /assinaturas_solicitacao/{docId} {
      allow read: if hasRole(['admin', 'gerente', 'almoxarife', 'compras']) && isActive();
      allow create: if hasRole(['admin', 'gerente', 'almoxarife', 'compras']) && isActive();
      allow delete: if hasRole(['admin', 'gerente', 'almoxarife', 'compras']) && isActive();
    }

    // Fotos da solicitação de compra (uma foto por documento, base64 no campo dataUrl)
    match /fotos_solicitacao/{docId} {
      allow read: if hasRole(['admin', 'gerente', 'almoxarife', 'compras']) && isActive();
      allow create: if hasRole(['admin', 'gerente', 'almoxarife', 'compras']) && isActive();
      allow delete: if hasRole(['admin', 'gerente', 'almoxarife', 'compras']) && isActive();
    }

    // Histórico de conversas do Agente IA. Cada conversa é privada do usuário que
    // conversou: só o dono lê, escreve e apaga (admin também, para suporte).
    match /conversas_agente/{docId} {
      allow read, update, delete: if isAuthenticated() && isActive()
                                  && (resource.data.uid == request.auth.uid || hasRole(['admin']));
      allow create: if isAuthenticated() && isActive()
                    && request.resource.data.uid == request.auth.uid;
    }

    // Fase 2 — Filtros
    match /filtros/{docId} {
      allow read: if isAuthenticated() && isActive();
      allow write: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
    }

    match /entradas_filtro/{docId} {
      allow read: if isAuthenticated() && isActive();
      allow create: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
    }

    match /baixas_filtro/{docId} {
      allow read: if isAuthenticated() && isActive();
      allow write: if hasRole(['admin', 'gerente', 'almoxarife', 'franca']) && isActive();
    }

    // Fase 2 — Manutenção
    match /ordens_servico/{docId} {
      allow read: if isAuthenticated() && isActive();
      allow create: if hasRole(['admin', 'gerente', 'almoxarife', 'franca']) && isActive();
      allow update: if hasRole(['admin', 'gerente', 'almoxarife', 'franca']) && isActive();
      allow delete: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
    }

    // Fotos do serviço das OS (uma foto por documento, base64 no campo dataUrl)
    match /fotos_os/{docId} {
      allow read: if isAuthenticated() && isActive();
      allow create: if hasRole(['admin', 'gerente', 'almoxarife', 'franca']) && isActive();
      allow delete: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
    }

    // Fotos da saída de material (uma foto por documento, base64 no campo dataUrl)
    match /fotos_saida/{docId} {
      allow read: if isAuthenticated() && isActive();
      allow create: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
      allow delete: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
    }

    // Assinaturas da saída (capability URL). O recebedor assina por link sem login:
    // get publico por token (sem listar a colecao), e update anonimo so para
    // preencher a assinatura do recebedor UMA vez (sem alterar o resto).
    match /assinaturas_saida/{token} {
      allow get: if true;
      allow list: if isAuthenticated() && isActive();
      allow create: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
      allow update: if (hasRole(['admin', 'gerente', 'almoxarife']) && isActive())
                    || (resource.data.recebeuAssinatura == null
                        && request.resource.data.recebeuAssinatura is string
                        && request.resource.data.ordemId == resource.data.ordemId
                        && request.resource.data.entregouAssinatura == resource.data.entregouAssinatura);
      allow delete: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
    }

    // Termos de entrega/devolução da locação (capability URL, igual às
    // assinaturas da saída). Quem abre o link é o cliente ou o colaborador que
    // foi recolher o material — sem login. Por isso:
    //  - get público pelo token, mas sem poder LISTAR a coleção;
    //  - update anônimo só UMA vez (pendente -> assinado), e sem poder mexer no
    //    evento, no tipo nem na LISTA DE ITENS: é justamente essa lista que as
    //    duas partes estão assinando.
    //  - na entrega, a assinatura da SOS já veio gravada e não pode ser trocada.
    match /termos_locacao/{token} {
      allow get: if true;
      allow list: if isAuthenticated() && isActive();
      allow create: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
      allow update: if (hasRole(['admin', 'gerente', 'almoxarife']) && isActive())
                    || (resource.data.status != 'assinado'
                        && request.resource.data.status == 'assinado'
                        && request.resource.data.clienteAssinatura is string
                        && request.resource.data.eventoId == resource.data.eventoId
                        && request.resource.data.tipo == resource.data.tipo
                        && request.resource.data.itens == resource.data.itens
                        && request.resource.data.geradores == resource.data.geradores
                        && (resource.data.tipo != 'entrega'
                            || request.resource.data.sosAssinatura == resource.data.sosAssinatura));
      allow delete: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
    }

    // Fotos da conferência do termo. Quem tira é o colaborador no local, pelo
    // link e sem login, então o create é anônimo — mas só para um termo que
    // EXISTE e ainda não foi assinado, o que fecha a porta depois do aceite.
    match /fotos_termo/{docId} {
      allow read: if isAuthenticated() && isActive();
      allow create: if request.resource.data.dataUrl is string
                    && request.resource.data.termoId is string
                    && exists(/databases/$(database)/documents/termos_locacao/$(request.resource.data.termoId))
                    && get(/databases/$(database)/documents/termos_locacao/$(request.resource.data.termoId)).data.status != 'assinado';
      allow delete: if hasRole(['admin', 'gerente', 'almoxarife']) && isActive();
    }
  }
}
